# ============================================================
# PRAHAR Frontend Environment Variables
# ============================================================

# Google Maps Platform API Key (Optional)
# Enables official Google Maps Satellite, Hybrid, and Terrain layers.
# If left blank, high-resolution zero-key fallbacks (Esri Satellite & CARTO Dark) are used automatically.
VITE_GOOGLE_MAPS_API_KEY=

# Default Basemap style: 'carto-dark' | 'esri-satellite' | 'google-hybrid' | 'carto-voyager'
VITE_DEFAULT_BASEMAP=carto-dark

# Backend API Service URL
VITE_API_URL=http://localhost:8010
