# ============================================================
# PRAHAR Frontend Environment Variables
# ============================================================

# Google Maps Platform API Key (Optional)
# Enables official Google Maps Satellite & Hybrid layers.
# If left blank, high-resolution zero-key satellite imagery is used automatically.
VITE_GOOGLE_MAPS_API_KEY=

# Default Basemap style: 'satellite' | 'streets' | 'google-hybrid'
VITE_DEFAULT_BASEMAP=satellite

# Backend API Service URL
VITE_API_URL=http://localhost:8010
